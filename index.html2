
!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EcoSphere AI | Sustainable Future</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="navbar">
    <div class="logo">🌍 EcoSphere <span>AI</span></div>
    <nav>
      <a href="#home">Home</a>
      <a h<ref="#solver">AI Solver</a>
      <a href="#calculator">Carbon Calculator</a>
    </nav>
  </header>

  <main> 
    
    <section class="dashboard section" id="dashboard">
      <p class="eyebrow">YOUR SUSTAINABILITY OVERVIEW</p>
      <h2>Planet Impact Dashboard 🌍</h2>
      <p>Explore your environmental impact and discover opportunities to improve.</p>

      <div class="dashboard-grid">
        <div class="dashboard-card">
          <div class="dashboard-icon">🌱</div>
          <p class="metric-label">Sustainability Score</p>
          <h3 id="ecoScore">75<span>/100</span></h3>
          <p class="metric-note">Illustrative starter score</p>
        </div>

        <div class="dashboard-card">
          <div class="dashboard-icon">⚡</div>
          <p class="metric-label">Monthly Electricity</p>
          <h3 id="dashboardUnits">— <span>kWh</span></h3>
          <p class="metric-note">Enter usage in the calculator below</p>
        </div>

        <div class="dashboard-card">
          <div class="dashboard-icon">🌍</div>
          <p class="metric-label">Estimated CO₂ Emissions</p>
          <h3 id="dashboardCarbon">— <span>kg</span></h3>
          <p class="metric-note">Based on your electricity entry</p>
        </div>

        <div class="dashboard-card">
          <div class="dashboard-icon">♻️</div>
          <p class="metric-label">Green Actions</p>
          <h3 id="greenActions">0 <span>completed</span></h3>
          <p class="metric-note">Track your sustainability habits</p>
        </div>
      </div>

      <div class="panel action-panel">
        <h3>🌿 Today's Green Challenge</h3>
        <p>Switch off lights and fans when leaving an empty room.</p>
        <label class="challenge-label">
          <input type="checkbox" id="greenChallenge">
          I completed today's challenge
        </label>
        <p id="challengeMessage" aria-live="polite"></p>
      </div>
    </section>

    <section class="hero" id="home">
      <div class="hero-content">
        <p class="eyebrow">INTELLIGENCE FOR A GREENER PLANET</p>
        <h1>Build a <span>sustainable</span> future with AI.</h1>
        <p class="intro">
          Turn environmental challenges into practical solutions.
          Explore smarter ways to save energy, water and our planet.
        </p>
        <a class="primary-btn" href="#solver">Explore AI Solver ↗</a>
      </div>
      <div class="earth">🌎</div>
    </section>

    <section class="section" id="solver">
      <p class="eyebrow">YOUR AI ASSISTANT</p>
      <h2>AI Sustainability Solver</h2>
      <p>Describe an environmental problem to explore possible solutions.</p>
      <div class="panel">
        <label for="problem">What problem do you want to solve?</label>
        <textarea id="problem" placeholder="Example: Our college wastes a lot of electricity..."></textarea>
        <label for="category">Select a category</label>
        <select id="category">
          <option>Energy</option>
          <option>Water</option>
          <option>Waste Management</option>
          <option>Carbon Emissions</option>
          <option>Biodiversity</option>
        </select>
        <button class="primary-btn" id="solveBtn" onclick="solveProblem()">Generate Solutions ✨</button>
        <div id="solution" class="result" aria-live="polite"></div>
      </div>
    </section>

    <section class="section" id="calculator">
      <p class="eyebrow">MEASURE YOUR IMPACT</p>
      <h2>Carbon Footprint Calculator</h2>
      <p>Estimate emissions from electricity usage.</p>
      <div class="panel">
        <label for="units">Monthly electricity consumption (kWh)</label>
        <input id="units" type="number" min="0" placeholder="Example: 150">
        <button class="primary-btn" onclick="calculateCarbon()">Calculate Footprint</button>
        <div id="carbonResult" class="result" aria-live="polite"></div>
        <p class="note">This is an illustrative estimate using 0.7 kg CO₂ per kWh. Actual grid emissions vary by location and time.</p>
      </div>
    </section>

    <section class="section impact">
      <p class="eyebrow">SMALL ACTIONS, BIG CHANGE</p>
      <h2>Every action counts.</h2>
      <div class="stats">
        <div class="stat"><span>💧</span><h3>Save Water</h3><p>Find ways to reduce water waste.</p></div>
        <div class="stat"><span>⚡</span><h3>Save Energy</h3><p>Discover efficient energy habits.</p></div>
        <div class="stat"><span>♻️</span><h3>Reduce Waste</h3><p>Support reuse and recycling.</p></div>
      </div>
    </section>
  </main>

  <footer>🌱 EcoSphere AI · Technology for a sustainable tomorrow</footer>
  
<!-- Sustainability Report -->
<section class="section" id="sustainability-report">
  <h2>🌍 Sustainability Report</h2>
  <p class="section-description">
    Understand your estimated carbon emissions and get AI-powered
    recommendations for a greener future.
  </p>

  <div class="report-grid">
    <div class="report-card">
      <span>⚡ Electricity Consumption</span>
      <h3 id="reportUnits">-- kWh</h3>
    </div>

    <div class="report-card">
      <span>🌿 Estimated Carbon Emissions</span>
      <h3 id="reportCarbon">-- kg CO₂</h3>
    </div>
  </div>
   
<!-- Sustainability Charts -->
<div class="chart-grid">
  <div class="chart-card">
    <h3>📊 Carbon Emissions Comparison</h3>
    <canvas id="emissionsBarChart"></canvas>
  </div>

  <div class="chart-card">
    <h3>🍩 20% Reduction Goal</h3>
    <canvas id="emissionsDoughnutChart"></canvas>
    <p class="chart-note">
      Illustrative target: reduce electricity-related emissions by 20%.
    </p>
  </div>
</div>

  <button class="primary-btn" id="reportBtn"
          onclick="generateSustainabilityReport()">
    Generate Sustainability Report ✨
  </button>

  <div id="reportRecommendations" class="result" aria-live="polite">
    Calculate your electricity usage first, then generate your report.
  </div>

  <p class="report-note">
    Carbon emissions are estimates, not exact measurements.
  </p>
</section>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="script.js"></script>
</body>
</html>
